+#[cfg(test)]
+mod write_tests {
+    use super::*;
+    use std::collections::VecDeque;
+    #[derive(Default)]
+    struct Writer {
+        bytes: Vec<u8>,
+        actions: VecDeque<Option<usize>>,
+        closed: bool,
+    }
+    impl AsyncRead for Writer {
+        fn poll_read(
+            self: Pin<&mut Self>,
+            _: &mut Context<'_>,
+            _: &mut ReadBuf<'_>,
+        ) -> Poll<std::io::Result<()>> {
+            Poll::Pending
+        }
+    }
+    impl AsyncWrite for Writer {
+        fn poll_write(
+            mut self: Pin<&mut Self>,
+            cx: &mut Context<'_>,
+            data: &[u8],
+        ) -> Poll<std::io::Result<usize>> {
+            match self.actions.pop_front().unwrap_or(Some(usize::MAX)) {
+                None => {
+                    cx.waker().wake_by_ref();
+                    Poll::Pending
+                }
+                Some(limit) => {
+                    let n = limit.min(data.len());
+                    self.bytes.extend_from_slice(&data[..n]);
+                    Poll::Ready(Ok(n))
+                }
+            }
+        }
+        fn poll_flush(self: Pin<&mut Self>, _: &mut Context<'_>) -> Poll<std::io::Result<()>> {
+            Poll::Ready(Ok(()))
+        }
+        fn poll_shutdown(
+            mut self: Pin<&mut Self>,
+            _: &mut Context<'_>,
+        ) -> Poll<std::io::Result<()>> {
+            self.closed = true;
+            Poll::Ready(Ok(()))
+        }
+    }
+    fn stream(actions: Vec<Option<usize>>) -> TlsPskStream<Writer> {
+        TlsPskStream {
+            inner: Writer {
+                actions: actions.into(),
+                ..Default::default()
+            },
+            keys: KeyBlock {
+                client_mac_key: vec![1; 48],
+                server_mac_key: vec![2; 48],
+                client_write_key: vec![3; 32],
+                server_write_key: vec![4; 32],
+                suite: CipherSuite::Aes256CbcSha384,
+            },
+            write_seq: 0,
+            read_seq: 0,
+            read_buf: vec![],
+            pending_record: vec![],
+            pending_record_total: 0,
+            write_buf: vec![],
+        }
+    }
+    fn plaintext(s: &TlsPskStream<Writer>) -> Vec<u8> {
+        let mut wire = s.inner.bytes.as_slice();
+        let mut result = vec![];
+        let mut seq = 0;
+        while !wire.is_empty() {
+            assert!(wire.len() >= 5);
+            let size = u16::from_be_bytes([wire[3], wire[4]]) as usize;
+            assert!(wire.len() >= 5 + size);
+            result
+                .extend(decrypt_record(&s.keys, false, seq, wire[0], &wire[5..5 + size]).unwrap());
+            wire = &wire[5 + size..];
+            seq += 1;
+        }
+        assert_eq!(seq, s.write_seq);
+        result
+    }
+    #[tokio::test]
+    async fn pending_and_partial_writes_preserve_exact_bytes() {
+        let mut s = stream(vec![None, Some(7), None, Some(13), None]);
+        let data: Vec<u8> = (0..70000).map(|i| (i % 251) as u8).collect();
+        s.write_all(&data).await.unwrap();
+        s.flush().await.unwrap();
+        let actual = plaintext(&s);
+        assert_eq!(actual.len(), data.len());
+        assert_eq!(actual, data);
+    }
+    #[tokio::test]
+    async fn zero_write_is_an_error() {
+        let mut s = stream(vec![Some(0)]);
+        assert_eq!(
+            s.write(b"hello").await.unwrap_err().kind(),
+            std::io::ErrorKind::WriteZero
+        );
+    }
+    #[tokio::test]
+    async fn zero_write_while_flushing_is_an_error() {
+        let mut s = stream(vec![Some(1), Some(0)]);
+        s.write_all(b"hello").await.unwrap();
+        assert_eq!(
+            s.flush().await.unwrap_err().kind(),
+            std::io::ErrorKind::WriteZero
+        );
+    }
+    #[tokio::test]
+    async fn empty_write_has_no_record() {
+        let mut s = stream(vec![]);
+        assert_eq!(s.write(&[]).await.unwrap(), 0);
+        assert!(s.inner.bytes.is_empty());
+        assert_eq!(s.write_seq, 0);
+    }
+    #[tokio::test]
+    async fn shutdown_drains_accepted_bytes() {
+        let mut s = stream(vec![None]);
+        s.write_all(b"accepted").await.unwrap();
+        s.shutdown().await.unwrap();
+        assert!(s.inner.closed);
+        assert_eq!(plaintext(&s), b"accepted");
+    }
+}
